msgid ""
msgstr ""
"Project-Id-Version: luci-app-nginx-proxy\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_Hant\n"

msgid "Nginx Reverse Proxy"
msgstr "Nginx 反向代理"

msgid "Rules"
msgstr "規則"

msgid "Name"
msgstr "名稱"

msgid "Domain"
msgstr "網域"

msgid "Listen"
msgstr "監聽埠"

msgid "Target"
msgstr "目標位址"

msgid "Enabled"
msgstr "啟用"

msgid "Auth"
msgstr "認證"

msgid "Actions"
msgstr "操作"

msgid "on"
msgstr "開"

msgid "off"
msgstr "關"

msgid "Edit"
msgstr "編輯"

msgid "Delete"
msgstr "刪除"

msgid "Delete this rule?"
msgstr "確定刪除這條規則？"

msgid "Apply and test"
msgstr "套用並測試"

msgid "Test configuration only"
msgstr "僅測試設定"

msgid "Edit rule"
msgstr "編輯規則"

msgid "Add rule"
msgstr "新增規則"

msgid "server_name; leave empty to accept any Host."
msgstr "server_name，留空表示接受任意 Host。"

msgid "host:port of the LAN service."
msgstr "內網服務的 host:port。"

msgid "Certificate"
msgstr "憑證"

msgid "No TLS (plain HTTP)"
msgstr "不啟用 TLS（明文 HTTP）"

msgid "acme certificates are renewed automatically; uploaded ones live in /etc/nginx-proxy/certs."
msgstr "acme 憑證自動續期；後台上傳的憑證存放在 /etc/nginx-proxy/certs。"

msgid "WebSocket"
msgstr "WebSocket"

msgid "Allow from WAN"
msgstr "允許公網存取"

msgid "Adds a firewall rule for the listen port only (IPv4 and IPv6)."
msgstr "只放行該監聽埠（IPv4/IPv6），不會全開。"

msgid "Basic auth user"
msgstr "Basic 認證使用者名稱"

msgid "Leave empty to disable basic auth."
msgstr "留空即關閉 basic 認證。"

msgid "Basic auth password"
msgstr "Basic 認證密碼"

msgid "Only stored as a hash; leave empty to keep the current password."
msgstr "只儲存雜湊；留空表示保持原密碼。"

msgid "Save and apply"
msgstr "儲存並套用"

msgid "Upload certificate"
msgstr "上傳憑證"

msgid "Certificate name"
msgstr "憑證名稱"

msgid "Certificate PEM"
msgstr "憑證 PEM"

msgid "Private key PEM"
msgstr "私鑰 PEM"

msgid "Upload"
msgstr "上傳"

msgid "Invalid user name"
msgstr "使用者名稱不合法"

msgid "Cannot write temp file"
msgstr "無法寫入暫存檔"

msgid "openssl passwd failed"
msgstr "openssl 產生密碼失敗"

msgid "Cannot write password file"
msgstr "無法寫入密碼檔"

msgid "Invalid token, please reload the page."
msgstr "token 失效，請重新整理頁面重試。"

msgid "Name, certificate and private key are all required."
msgstr "名稱、憑證、私鑰都必須填寫。"

msgid "That does not look like PEM certificate/key."
msgstr "內容不像 PEM 憑證/私鑰。"

msgid "Certificate did not parse: "
msgstr "憑證解析失敗："

msgid "Certificate uploaded: "
msgstr "憑證已上傳："

msgid "Name and target (host:port) are required."
msgstr "名稱和目標位址（host:port）必填。"

msgid "Listen port must be a number."
msgstr "監聽埠必須是數字。"

msgid "Reverse proxy rules are rendered into /etc/nginx/conf.d/proxy.d/ and only that directory is touched. The main LuCI server configuration (uci.conf, nginx.conf, luci.locations) is never modified."
msgstr "規則只渲染到 /etc/nginx/conf.d/proxy.d/，只改這一個目錄；LuCI 主站設定（uci.conf、nginx.conf、luci.locations）不會被修改。"
