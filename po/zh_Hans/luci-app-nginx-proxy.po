"Project-Id-Version: luci-app-nginx-proxy\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_Hans\n"

msgid "Nginx Reverse Proxy"
msgstr "Nginx 反向代理"

msgid "Rules"
msgstr "规则"

msgid "Name"
msgstr "名称"

msgid "Domain"
msgstr "域名"


msgid "Listen port"
msgstr "监听端口"

msgid "Target"
msgstr "目标地址"

msgid "Target (host:port)"
msgstr "目标地址（host:port）"

msgid "Enabled"
msgstr "启用"

msgid "Auth"
msgstr "认证"

msgid "Actions"
msgstr "操作"

msgid "Toggle"
msgstr "切换"

msgid "Edit"
msgstr "编辑"

msgid "View config"
msgstr "查看配置"

msgid "Delete"
msgstr "删除"

msgid "Delete this rule?"
msgstr "确定删除这条规则？"

msgid "Edit rule"
msgstr "编辑规则"

msgid "Add rule"
msgstr "新增规则"

msgid "Back"
msgstr "返回"

msgid "Cancel"
msgstr "取消"

msgid "Generated configuration"
msgstr "生成的配置"

msgid "Certificate"
msgstr "证书"

msgid "None (plain HTTP)"
msgstr "不使用（明文 HTTP）"

msgid "WebSocket"
msgstr "WebSocket"

msgid "Allow WAN access"
msgstr "允许公网访问"

msgid "Basic auth user"
msgstr "认证用户"

msgid "Basic auth password"
msgstr "认证密码"


msgid "Save and apply"
msgstr "保存并应用"

msgid "Upload"
msgstr "上传"

msgid "Upload certificate"
msgstr "上传证书"

msgid "Certificate (PEM)"
msgstr "证书（PEM）"

msgid "Private key (PEM)"
msgstr "私钥（PEM）"

msgid "Rules are rendered only into /etc/nginx/conf.d/proxy.d/. LuCI's own configuration (uci.conf, nginx.conf, luci.locations) is never modified."
msgstr "规则只渲染到 /etc/nginx/conf.d/proxy.d/，只改这一个目录；LuCI 主站配置（uci.conf、nginx.conf、luci.locations）不会被修改。"

msgid "Optional. Leave empty to accept any Host header."
msgstr "可选；留空表示接受任意 Host。"


msgid "Opens only this TCP port in the firewall. It does not add any access control."
msgstr "只放行该 TCP 端口，不附带任何访问控制。"

msgid "Leave empty to disable basic auth. Strongly recommended for rules reachable from the internet."
msgstr "留空即关闭 basic 认证；公网可达的规则强烈建议开启。"

msgid "Only the apr1 hash is stored; leave empty to keep the current password."
msgstr "只保存 apr1 哈希；留空表示保持原密码。"

msgid "Saving applies immediately: nginx -t, then a reload; on failure the previous configuration is restored."
msgstr "保存即生效：先 nginx -t，再 reload；失败会恢复上一份配置。"

msgid "Invalid user name"
msgstr "用户名不合法"

msgid "Cannot write temp file"
msgstr "无法写临时文件"

msgid "openssl passwd failed"
msgstr "openssl 生成密码失败"

msgid "Cannot write password file"
msgstr "无法写密码文件"

msgid "Invalid token, please reload the page."
msgstr "token 失效，请刷新页面重试。"

msgid "Name, certificate and private key are all required."
msgstr "名称、证书、私钥都必须填写。"

msgid "That does not look like PEM certificate/key."
msgstr "内容不像 PEM 证书/私钥。"

msgid "Certificate did not parse: "
msgstr "证书解析失败："

msgid "Certificate uploaded: "
msgstr "证书已上传："

msgid "Name and target (host:port) are required."
msgstr "名称和目标地址（host:port）必填。"

msgid "Listen port must be a number."
msgstr "监听端口必须是 1-65535 的数字。"

msgid "Invalid domain name."
msgstr "域名不合法。"

msgid "Invalid path prefix."
msgstr "路径前缀不合法。"

msgid "Unknown certificate."
msgstr "未知的证书。"
msgid "Family"
msgstr "协议族"
msgid "IP family"
msgstr "IP 协议族"
msgid "IPv4 + IPv6"
msgstr "IPv4 + IPv6"
msgid "IPv4 only"
msgstr "仅 IPv4"
msgid "IPv6 only"
msgstr "仅 IPv6"
msgid "IPv6 only listens on [::] and the firewall rule is IPv6-only."
msgstr "仅 IPv6 时只监听 [::]，防火墙规则也只放行 IPv6。"
msgid "Options"
msgstr "选项"
msgid "Extra directives"
msgstr "额外指令"
msgid "One per line, inserted inside the location block, must end with ';'. Passed to nginx -t before applying."
msgstr "每行一条，插入 location 块内，需以 ; 结尾；应用前会先跑 nginx -t。"
msgid "Extra directives must be one per line and end with ';' (no braces)."
msgstr "额外指令必须每行一条、以 ; 结尾，且不能包含花括号。"
msgid "Invalid IP family."
msgstr "IP 协议族不合法。"
msgid "No rules yet."
msgstr "暂无规则。"

msgid "Allow WAN"
msgstr "允许公网"

msgid "HTTP 301 to HTTPS"
msgstr "HTTP 301 跳转到 HTTPS"

msgid "Name and target (host:port, http(s):// optional) are required."
msgstr "名称和目标地址必填（host:port，可带 http(s)://）"

msgid "Needs a certificate and a domain."
msgstr "需要证书和域名"

msgid "empty = disabled"
msgstr "留空则关闭"

msgid "empty = keep current"
msgstr "留空则保持原密码"

msgid "optional"
msgstr "可选"

msgid "Auth!"
msgstr "认证失效"

msgid "Password is gone after reflash; open Edit and retype it."
msgstr "重刷固件后密码丢失，请编辑该规则重新输入。"

msgid "Auth users"
msgstr "认证用户"

msgid "Shared by every rule that has \"Require login\" checked. Stored in /etc/config/nginx_proxy, so they survive firmware upgrades; the htpasswd file is rebuilt on every apply."
msgstr "所有勾选「需要认证」的规则共用这份列表。凭据存在 /etc/config/nginx_proxy 里，升级固件不会丢；每次应用时重建 htpasswd 文件。"

msgid "Require login"
msgstr "需要认证"

msgid "Uses the shared user list below."
msgstr "使用下方共享用户列表。"

msgid "User"
msgstr "用户"

msgid "Password"
msgstr "密码"

msgid "Add user"
msgstr "添加用户"

msgid "Delete this user?"
msgstr "删除该用户？"

msgid "No auth users yet."
msgstr "还没有认证用户。"

msgid "User saved: "
msgstr "用户已保存："

msgid "User name (letters, digits, . _ -) and password are required."
msgstr "用户名（字母、数字、. _ -）和密码都必须填写。"

msgid "Cannot write temp file."
msgstr "无法写临时文件。"

msgid "Could not hash the password."
msgstr "无法生成密码哈希。"
