#!/bin/sh
# nginx-proxy：把 /etc/config/nginx_proxy 渲染成 nginx server 块并原子应用。
# 只写 /etc/nginx/conf.d/proxy.d/*.conf，永不改 uci.conf / nginx.conf / luci.locations。
# functions.sh 会引用 IPKG_INSTROOT 等变量，不能开 set -u
IPKG_INSTROOT=
export IPKG_INSTROOT
. /lib/functions.sh

CONF_DIR=/etc/nginx/conf.d
PROXY_DIR=$CONF_DIR/proxy.d
DATA_DIR=/etc/nginx-proxy
CERT_DIR=$DATA_DIR/certs
HTPASSWD_DIR=$DATA_DIR/htpasswd
BACKUP=$DATA_DIR/last-good
NGX_CONF=/etc/nginx/uci.conf

log() { logger -t nginx-proxy "$*"; }

nginx_test() { /usr/sbin/nginx -t -c "$NGX_CONF" 2>&1; }

proxy_headers() {
	local ws="$1"
	echo "		proxy_http_version 1.1;"
	echo "		proxy_set_header Host \$host;"
	echo "		proxy_set_header X-Real-IP \$remote_addr;"
	echo "		proxy_set_header X-Forwarded-For \$remote_addr;"
	echo "		proxy_set_header X-Forwarded-Proto \$scheme;"
	if [ "$ws" = "1" ]; then
		echo "		proxy_set_header Upgrade \$http_upgrade;"
		echo "		proxy_set_header Connection \"upgrade\";"
		echo "		proxy_read_timeout 1h;"
	fi
}

render_one() {
	local s="$1" out="$2"
	local enabled name domain listen target ws auth_user cert key
	config_get_bool enabled "$s" enabled 1
	[ "$enabled" = "1" ] || [ "${NP_FORCE:-0}" = "1" ] || return 0
	config_get name   "$s" name   "$s"
	config_get domain "$s" domain ""
	config_get listen "$s" listen "443"
	config_get target "$s" target ""
	config_get_bool ws "$s" websocket 0
	config_get auth_user "$s" auth_user ""
	config_get cert "$s" cert ""
	config_get key  "$s" key  ""
	# cert 允许写名字（t3）或绝对路径（/etc/nginx-proxy/certs/t3.crt）
	if [ -n "$cert" ] && [ "${cert#/}" = "$cert" ]; then
		key="$CERT_DIR/$cert.key"
		cert="$CERT_DIR/$cert.crt"
	fi
	[ -n "$target" ] || return 0

	# 只允许安全字符，避免把 uci 值直接拼进配置造成注入
	case "$listen" in ''|*[!0-9]*) listen=443;; esac
	case "$target" in ''|*[!A-Za-z0-9.:_\[\]-]*) log "skip $s: bad target"; return 0;; esac

	{
		echo "# generated by nginx-proxy from /etc/config/nginx_proxy ($s); do not edit"
		echo "server {"
		if [ -n "$cert" ] && [ -n "$key" ] && [ -f "$cert" ] && [ -f "$key" ]; then
			echo "	listen $listen ssl;"
			echo "	listen [::]:$listen ssl;"
			echo "	ssl_certificate $cert;"
			echo "	ssl_certificate_key $key;"
			echo "	ssl_protocols TLSv1.2 TLSv1.3;"
		else
			echo "	listen $listen;"
			echo "	listen [::]:$listen;"
		fi
		[ -n "$domain" ] && echo "	server_name $domain;"
		if [ -n "$auth_user" ] && [ -f "$HTPASSWD_DIR/$s" ]; then
			echo "	auth_basic \"$name\";"
			echo "	auth_basic_user_file $HTPASSWD_DIR/$s;"
		fi
		echo "	location / {"
		echo "		proxy_pass http://$target;"
		proxy_headers "$ws"
		echo "	}"
		echo "}"
	} > "$out/$s.conf"
}

render_all() {
	local out="$1"
	rm -rf "$out"; mkdir -p "$out" || return 1
	config_load nginx_proxy
	config_foreach render_one proxy "$out"
}

sync_wan() {
	local want="" s port
	config_load nginx_proxy
	config_foreach collect_wan proxy
	for s in $(uci -q show firewall | sed -n "s/^firewall\.\(npxy_[0-9A-Za-z_]*\)=rule$/\1/p"); do
		case " $want " in
			*" $s "*) ;;
			*) uci -q delete "firewall.$s";;
		esac
	done
	uci -q commit firewall
}

collect_wan() {
	local s="$1" allow port
	config_get_bool allow "$s" allow_wan 0
	[ "$allow" = "1" ] || return 0
	config_get port "$s" listen "443"
	sec="npxy_$port"
	uci -q get "firewall.$sec" >/dev/null 2>&1 || {
		uci set "firewall.$sec=rule"
		uci set "firewall.$sec.name=Allow-nginx-proxy-$port"
		uci set "firewall.$sec.src=wan"
		uci set "firewall.$sec.proto=tcp"
		uci set "firewall.$sec.dest_port=$port"
		uci set "firewall.$sec.target=ACCEPT"
		uci set "firewall.$sec.family=any"
	}
	want="$want $sec"
}

do_apply() {
	local out tmp=/tmp/nginx-proxy.new
	local lock=/var/lock/nginx-proxy.lock i=0
	# 页面连点/并发请求时不要互相删目录
	while ! mkdir "$lock" 2>/dev/null; do
		# 上次 apply 被 kill 时留下的锁：看 pid 是否还活着
		if [ -f "$lock/pid" ] && ! kill -0 "$(cat "$lock/pid")" 2>/dev/null; then
			rm -rf "$lock"
			continue
		fi
		i=$((i+1)); [ "$i" -gt 30 ] && { echo "FAILED"; echo "another apply is running"; return 1; }
		sleep 1
	done
	echo $$ > "$lock/pid"
	trap 'rmdir "$lock" 2>/dev/null' EXIT
	mkdir -p "$DATA_DIR" "$CERT_DIR" "$HTPASSWD_DIR"
	chmod 700 "$DATA_DIR" "$CERT_DIR" "$HTPASSWD_DIR"
	render_all "$tmp" || { echo "FAILED"; echo "render failed"; return 1; }
	rm -rf "$BACKUP"
	if [ -d "$PROXY_DIR" ]; then cp -a "$PROXY_DIR" "$BACKUP"; fi
	rm -rf "$PROXY_DIR"
	mv "$tmp" "$PROXY_DIR" || { echo "FAILED"; echo "cannot write $PROXY_DIR"; return 1; }
	if out=$(nginx_test); then
		sync_wan
		/etc/init.d/nginx reload >/dev/null 2>&1 || /etc/init.d/nginx restart >/dev/null 2>&1
		echo "OK"
		echo "$out"
		log "applied"
		return 0
	fi
	echo "FAILED"
	echo "$out"
	rm -rf "$PROXY_DIR"
	if [ -d "$BACKUP" ]; then cp -a "$BACKUP" "$PROXY_DIR"; fi
	/etc/init.d/nginx restart >/dev/null 2>&1
	log "apply failed, rolled back: $out"
	return 1
}

case "${1:-apply}" in
	apply)  do_apply ;;
	render) render_all "${2:-/tmp/nginx-proxy.render}" && echo OK ;;
	test)   nginx_test ;;
	show)
		NP_FORCE=1; export NP_FORCE
		d=/tmp/.nginx-proxy-show.$$
		rm -rf "$d"; mkdir -p "$d"
		config_load nginx_proxy
		render_one "$2" "$d" || true
		if [ -f "$d/$2.conf" ]; then cat "$d/$2.conf"; else echo "# no such rule: $2"; fi
		rm -rf "$d" ;;
	*) echo "usage: nginx-proxy {apply|render|test|show <section>}" >&2; exit 1 ;;
esac
